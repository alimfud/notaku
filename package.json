{
  "name": "notaku",
  "version": "1.7.3",
  "private": true,
  "type": "module",
  "description": "NotaKu Android application",
  "scripts": {
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "pretest": "npm run version:check",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "preprepare:web": "npm run version:sync",
    "prepare:web": "node scripts/prepare-web.mjs",
    "android:sync": "npm run prepare:web && cap sync android",
    "android:build": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:bundle": "npm run android:sync && cd android && gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "8.2.0",
    "@capacitor/android": "8.5.2",
    "@capacitor/browser": "8.0.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/share": "8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2"
  }
}
